<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="CheckMark_Template" src="project://database/Assets/Resources/UI/BasicElements/CheckMark_Template.uxml?fileID=9197481963319205126&amp;guid=a5a5c11397b72bf4cae40f1bd7eebe29&amp;type=3#CheckMark_Template"/>
    <ui:Template name="MinusButton_Template 1" src="project://database/Assets/Resources/UI/BasicElements/MinusButton_Template%201.uxml?fileID=9197481963319205126&amp;guid=575805bba40b21c42bda05597199cc8b&amp;type=3#MinusButton_Template 1"/>
    <ui:Template name="PlusButton_Template" src="project://database/Assets/Resources/UI/BasicElements/PlusButton_Template.uxml?fileID=9197481963319205126&amp;guid=d78e237d24a25374d81b671fe8108cf3&amp;type=3#PlusButton_Template"/>
    <ui:Template name="SliderInt_Template" src="project://database/Assets/Resources/UI/BasicElements/SliderInt_Template.uxml?fileID=9197481963319205126&amp;guid=a0eddaae79ab37e4e8de7439821b9635&amp;type=3#SliderInt_Template"/>
