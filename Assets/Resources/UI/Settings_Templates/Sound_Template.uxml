        </ui:VisualElement>
        <ui:VisualElement name="Plus_VisualElement" class="Plus_VisualElement MinusPlus_VisualElement">
            <ui:Instance template="PlusButton_Template" name="Plus_Template" class="MinusPlus_Template"/>
        </ui:VisualElement>
    </ui:VisualElement>
