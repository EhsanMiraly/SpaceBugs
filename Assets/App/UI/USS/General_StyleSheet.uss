:root {
}

.MatchParent {
    width: 100%;
    height: 100%;
}

.PageBackground {
    background-color: rgb(60, 27, 130);
}

.MainPageButtonsHolder {
    width: 50%;
    height: 100%;
    align-self: center;
    justify-content: center;
}

.MainPageButtons {
    width: 100%;
    height: 100px;
    font-size: 200%;
    -unity-text-align: middle-center;
    border-top-left-radius: 32px;
    border-top-right-radius: 32px;
    border-bottom-right-radius: 32px;
    border-bottom-left-radius: 32px;
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-left-color: rgb(0, 0, 255);
    border-right-color: rgb(0, 0, 255);
    border-top-color: rgb(0, 0, 255);
    border-bottom-color: rgb(0, 0, 255);
    margin-bottom: 1%;
    background-color: rgb(0, 255, 0);
    -unity-text-generator: advanced;
}

.Menu {
    background-color: rgb(255, 0, 0);
    width: 5.4%;
    height: 9.6%;
    background-image: url("project://database/Assets/App/Sprites/Icons/Picto_Icons/White/Menu-256.png?fileID=2800000&guid=cd8caa70fc31b0747a049ceb231a2608&type=3#Menu-256");
    align-self: flex-end;
}

.Settings_ScrollView {
}

.LevelsHolder {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: flex-start;
    width: 100%;
    height: 80%;
}

.SettingsHolder {
    width: 100%;
    height: 80%;
}

.Back_VisualElement {
    width: 10%;
    height: 20%;
}

.BackButton_Background {
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-top-left-radius: 256px;
    border-top-right-radius: 256px;
    border-bottom-right-radius: 256px;
    border-bottom-left-radius: 256px;
    border-left-color: rgb(0, 255, 255);
    border-right-color: rgb(0, 255, 255);
    border-top-color: rgb(0, 255, 255);
    border-bottom-color: rgb(0, 255, 255);
    background-color: rgba(0, 255, 255, 0.2);
}

.BackButton_Foreground {
    background-image: url("project://database/Assets/App/Sprites/Icons/Picto_Icons/White/LeftArrow-256.png?fileID=2800000&guid=6740d81fea070b54a9390cc6a99bcc75&type=3#LeftArrow-256");
}
